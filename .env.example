# Copy to .env for local overrides. Never commit real values.
# Every backend setting uses the QUORUM_ prefix; unknown QUORUM_* names are
# rejected at startup so typos fail loudly.

QUORUM_ENV=development
# Must use the asyncpg driver. Host port 5433 is the Compose database.
QUORUM_DATABASE_URL=postgresql+asyncpg://quorum:quorum@localhost:5433/quorum
QUORUM_DB_POOL_SIZE=5
QUORUM_DB_CONNECT_TIMEOUT_S=5
QUORUM_LOG_LEVEL=INFO
# json (default) or text
QUORUM_LOG_FORMAT=json
QUORUM_API_HOST=127.0.0.1
QUORUM_API_PORT=8000
# Browser origins allowed to call the API (the dashboard).
QUORUM_CORS_ORIGINS=http://localhost:3000

# Worker. Keep heartbeat <= lease_ttl / 2 (validated at startup).
QUORUM_WORKER_CONCURRENCY=4
QUORUM_LEASE_TTL_S=30
QUORUM_HEARTBEAT_INTERVAL_S=5
QUORUM_POLL_INTERVAL_S=2
QUORUM_SHUTDOWN_GRACE_S=20
QUORUM_WORKER_LISTEN=true

# `quorum all` (one container: API + scheduler + supervised workers, for free hosting)
QUORUM_ALL_IN_ONE_WORKERS=2

# Scheduler / reaper
QUORUM_REAPER_INTERVAL_S=5
QUORUM_REAPER_BATCH_SIZE=100
QUORUM_WORKER_UNHEALTHY_AFTER_S=15
QUORUM_WORKER_DEAD_AFTER_S=60
QUORUM_CRON_TICK_S=1
QUORUM_AGING_TICK_S=5
QUORUM_AGING_INTERVAL_S=10
QUORUM_AGING_MAX_BONUS=200
QUORUM_LEADER_CHECK_INTERVAL_S=2
QUORUM_LEADER_RETRY_INTERVAL_S=2

# Built-in task limits
QUORUM_HTTP_ALLOWLIST=localhost,127.0.0.1
QUORUM_HTTP_TIMEOUT_S=10
QUORUM_HTTP_MAX_BYTES=262144

# Test suite only: server used to create throwaway test databases.
TEST_DATABASE_URL=postgresql+asyncpg://quorum:quorum@localhost:5433/quorum

# Compose host ports (optional).
# QUORUM_DB_HOST_PORT=5433
# QUORUM_API_HOST_PORT=8000
