# Copy to .env for local overrides. Never commit real values.
# Every backend setting uses the CONDUCTOR_ prefix; unknown CONDUCTOR_* names are
# rejected at startup so typos fail loudly.

CONDUCTOR_ENV=development
# Must use the asyncpg driver. Host port 5433 is the Compose database.
CONDUCTOR_DATABASE_URL=postgresql+asyncpg://conductor:conductor@localhost:5433/conductor
CONDUCTOR_DB_POOL_SIZE=5
CONDUCTOR_DB_CONNECT_TIMEOUT_S=5
CONDUCTOR_LOG_LEVEL=INFO
# json (default) or text
CONDUCTOR_LOG_FORMAT=json
CONDUCTOR_API_HOST=127.0.0.1
CONDUCTOR_API_PORT=8000

# Worker. Keep heartbeat <= lease_ttl / 2 (validated at startup).
CONDUCTOR_WORKER_CONCURRENCY=4
CONDUCTOR_LEASE_TTL_S=30
CONDUCTOR_HEARTBEAT_INTERVAL_S=5
CONDUCTOR_POLL_INTERVAL_S=2
CONDUCTOR_SHUTDOWN_GRACE_S=20
CONDUCTOR_WORKER_LISTEN=true

# Scheduler / reaper
CONDUCTOR_REAPER_INTERVAL_S=5
CONDUCTOR_REAPER_BATCH_SIZE=100
CONDUCTOR_WORKER_UNHEALTHY_AFTER_S=15
CONDUCTOR_WORKER_DEAD_AFTER_S=60

# Test suite only: server used to create throwaway test databases.
TEST_DATABASE_URL=postgresql+asyncpg://conductor:conductor@localhost:5433/conductor

# Compose host ports (optional).
# CONDUCTOR_DB_HOST_PORT=5433
# CONDUCTOR_API_HOST_PORT=8000
