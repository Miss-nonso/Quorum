# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env and fill in.
# Never commit the filled-in file (deploy/.env is git-ignored).

# Public hostname of the API (Caddy obtains a TLS certificate for it).
API_DOMAIN=api.quorum.example.com
ACME_EMAIL=you@example.com
# The dashboard's origin (Vercel), allowed by CORS.
DASHBOARD_ORIGIN=https://quorum.example.com
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
# Backend image published by CI (see .github/workflows/release.yml).
QUORUM_IMAGE=ghcr.io/miss-nonso/quorum-backend:latest
